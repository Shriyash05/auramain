# ============================================================
# AURA ENVIRONMENT VARIABLES (PRODUCTION & STAGING)
# ============================================================

# 1. Supabase Cloud Configuration (Client-safe)
# Obtain from: Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Virtual Try-On (VTO) Remote Backend Proxy URL (Client-safe)
# Points to serverless GPU proxy (e.g. Supabase Edge Function / Cloudflare Worker)
# NEVER put private GPU provider tokens in client code!
EXPO_PUBLIC_VTO_API_URL=https://your-gpu-vto-service.example.com

# 3. Vision & Background Removal Proxy URL (Optional / Client-safe)
EXPO_PUBLIC_IMAGE_PROCESSING_API_URL=https://your-project-id.supabase.co/functions/v1/segment-garment

# ============================================================
# SERVER-SIDE ONLY SECRETS (Set in Supabase Vault / Edge Functions)
# DO NOT PREFIX WITH EXPO_PUBLIC_
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1Ni...
# AURA_MODEL_SERVER_AUTH_TOKEN=aura_sec_...
# VTO_JWT_SECRET=server-side-only-supabase-jwt-secret
# VTO_WEIGHTS_DIR=/secure/path/to/services/vto/weights
# VTO_MODEL_RESOLUTION=672,432
# VTO_INPUT_BUCKET=vto_inputs
# VTO_OUTPUT_BUCKET=vto_results
# SENTRY_DSN=https://...
