{
  "expo": {
    "name": "AURA",
    "slug": "aura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aura",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F9F8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aura.fashion"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F9F8"
      },
      "package": "com.aura.fashion"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "AURA accesses your photo library to let you add clothing items to your digital wardrobe.",
          "cameraPermission": "AURA uses your camera so you can photograph your clothes for instant styling."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
