{
  "experiment": {
    "id": "garment-exp-0013",
    "name": "aura-garment-v1-siglip-so400m-exp0013-lora-peft",
    "seed": 42,
    "description": "LoRA / PEFT adaptation experiment on frozen dataset-v0.4-250 (N=250) targeting SigLIP-SO400M attention query/value projections (r=8, alpha=16, dropout=0.05) with 256-dim bottleneck head, equal 1.0 loss weights, and deterministic seed."
  },
  "model": {
    "base_architecture": "google/siglip-so400m-patch14-384",
    "canonical_taxonomy_path": "data/garment/metadata/canonical_taxonomy.json",
    "freeze_backbone": false,
    "use_lora": true,
    "lora_rank": 8,
    "lora_alpha": 16.0,
    "lora_dropout": 0.05,
    "lora_target_modules": [
      "q_proj",
      "v_proj"
    ],
    "hidden_dim": 1152,
    "bottleneck_dim": 256,
    "head_dropout": 0.3,
    "unfreeze_last_n_layers": 0
  },
  "dataset": {
    "manifest_path": "data/garment/metadata/dataset-v0.4-250.json",
    "canonical_taxonomy_path": "data/garment/metadata/canonical_taxonomy.json",
    "version": "0.4.0",
    "image_size": 384,
    "num_workers": 0,
    "allowed_splits": [
      "train",
      "validation"
    ],
    "isolated_test_splits": [
      "blind_test",
      "hard_test",
      "real_world_test"
    ]
  },
  "training": {
    "device": "cuda",
    "mixed_precision": "fp16",
    "batch_size": 1,
    "gradient_accumulation_steps": 16,
    "epochs": 50,
    "learning_rate": 0.0005,
    "lora_learning_rate": 0.0002,
    "weight_decay": 0.05,
    "optimizer": "AdamW",
    "scheduler": "cosine",
    "early_stopping_patience": 25
  },
  "loss_weights": {
    "category_loss": 1.0,
    "fit_loss": 1.0,
    "silhouette_loss": 1.0,
    "color_loss": 1.0,
    "pattern_loss": 1.0,
    "material_loss": 1.0,
    "formality_loss": 1.0
  },
  "output": {
    "runs_dir": "training/runs",
    "save_best_only": false,
    "export_onnx": false
  }
}