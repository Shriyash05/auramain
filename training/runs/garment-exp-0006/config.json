{
  "experiment": {
    "id": "garment-exp-0006",
    "name": "aura-garment-v1-siglip-multitask-heads-v0.3-real-gpu",
    "seed": 42,
    "description": "Frozen SigLIP-SO400M vision backbone with multi-task classification heads trained on real NVIDIA GTX 1650 GPU"
  },
  "model": {
    "base_architecture": "google/siglip-so400m-patch14-384",
    "canonical_taxonomy_path": "data/garment/metadata/canonical_taxonomy.json",
    "freeze_backbone": true,
    "hidden_dim": 1152,
    "head_dropout": 0.1,
    "use_lora": false,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05
  },
  "dataset": {
    "manifest_path": "data/garment/metadata/dataset-v0.3.json",
    "canonical_taxonomy_path": "data/garment/metadata/canonical_taxonomy.json",
    "version": "0.3.0",
    "image_size": 384,
    "num_workers": 2,
    "allowed_splits": [
      "train",
      "validation"
    ],
    "isolated_test_splits": [
      "blind_test",
      "hard_test",
      "real_world_test"
    ]
  },
  "training": {
    "device": "cuda",
    "mixed_precision": "fp16",
    "batch_size": 4,
    "gradient_accumulation_steps": 4,
    "epochs": 20,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "warmup_ratio": 0.1,
    "optimizer": "AdamW",
    "scheduler": "cosine",
    "early_stopping_patience": 5
  },
  "loss_weights": {
    "category_loss": 1.0,
    "fit_loss": 0.8,
    "silhouette_loss": 0.6,
    "color_loss": 0.8,
    "pattern_loss": 0.5,
    "material_loss": 0.6,
    "formality_loss": 0.4
  },
  "output": {
    "runs_dir": "training/runs",
    "save_best_only": false,
    "export_onnx": true,
    "onnx_output_path": "aura-garment-v1.onnx"
  }
}